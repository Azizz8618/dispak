program t(output);
type w2 = packed record l, r: 0..16777215 end;
var
  i, j, k: integer;
  pw: @w2;
  x: w2;
begin
  (* тест 1: сохраняется ли СМ через pi := ref() и уи М5 *)
  i := 12345;               (* СМ := 12345 при вычислении *)
  pw := ref(x);
  besm(400005B);            (* М5 := адрес x *)
  besm(24000000B);          (* зп (М5): x := СМ *)
  writeln('t1 x.l=', x.l, ' x.r=', x.r, ' (ждём 0 12345)');

  (* тест 2: сохраняется ли М5 через присваивание Паскаля *)
  x.l := 0; x.r := 0;
  pw := ref(x);
  besm(400005B);            (* М5 := адрес x *)
  j := 999;                 (* присваивание между уи и зп *)
  besm(24000000B);          (* зп (М5): x := СМ(=999?) *)
  writeln('t2 x.r=', x.r, ' (ждём 999)');

  (* тест 3: счи М16 - что на СМ *)
  besm(420016B);            (* СМ := М16 *)
  pw := ref(x);
  besm(400005B);
  besm(24000000B);
  writeln('t3 x.l=', x.l, ' x.r=', x.r)
end.
*execute
*end file
