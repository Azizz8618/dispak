eeв1а3
*name
*call yesmemory
*perso:402570
*stand
*call *pascal
(*=y+,s7*)program testarfa(output);
(* ТЕСТ БИБЛИОТЕКИ ARFALIB (ТОМ 2348, ЗОНА 02570 - РЯДОМ С ГОСТ).
   Вся работа с зашифрованными областями архива АРФА - через
   внешние процедуры объектного модуля ARFALIB:
     ARFACRE - создание области (Э63 01)
     ARFAWRE - шифрование ГОСТ 28147-89 и запись зоны (Э63 12 + Э70)
     ARFARDD - чтение зоны и расшифрование (Э70 + Э63 12)
     ARFADEL - уничтожение области (Э63 02)
   Два зашифрованных отрывка текста записываются в зоны 0 и 1
   области ТЕКСТ, затем считываются, расшифровываются и сверяются. *)
type
  tword = packed record case integer of
    1: (a: alfa);
    2: (l, r: 0..16777215)
  end;
  W8 = array [1..8] of integer;
  S16 = array [1..16] of integer;
  CtxT = record
    roundkey: array [1..32] of integer;
    sbox: array [1..8] of array [0..15] of integer
  end;
  PtrW = @integer;
var
  i, ok: integer;
  fragA, fragB, res: array [1..8] of tword;
  ibuf, obuf: array [1..16] of integer;
  key: W8;
  s1, s2, s3, s4, s5, s6, s7, s8: S16;
  ctx: CtxT;
procedure GOSTINIT(var c2: CtxT; k2: W8;
  a8: S16; a7: S16; a6: S16; a5: S16;
  a4: S16; a3: S16; a2: S16; a1: S16); external;
procedure ARFACRE(nl, nr, n3, sc, ln: integer;
  var ok: integer); external;
procedure ARFADEL(nl, nr, n3, sc: integer; var ok: integer); external;
procedure ARFAWRE(nl, nr, n3, sc, nw, zn, iv: integer;
  var c2: CtxT; src: PtrW; var ok: integer); external;
procedure ARFARDD(nl, nr, n3, sc, nw, zn: integer;
  var c2: CtxT; dst: PtrW; var ok: integer); external;

begin
  writeln('ТЕСТ БИБЛИОТЕКИ ARFALIB: ЗАШИФРОВАННЫЕ ОБЛАСТИ АРФА');

  s1[1] := 1; s1[2] := 7; s1[3] := 14; s1[4] := 13;
  s1[5] := 0; s1[6] := 5; s1[7] := 8; s1[8] := 3;
  s1[9] := 4; s1[10] := 15; s1[11] := 10; s1[12] := 6;
  s1[13] := 9; s1[14] := 12; s1[15] := 11; s1[16] := 2;
  s2[1] := 8; s2[2] := 14; s2[3] := 2; s2[4] := 5;
  s2[5] := 6; s2[6] := 9; s2[7] := 1; s2[8] := 12;
  s2[9] := 15; s2[10] := 4; s2[11] := 11; s2[12] := 0;
  s2[13] := 13; s2[14] := 10; s2[15] := 3; s2[16] := 7;
  s3[1] := 5; s3[2] := 13; s3[3] := 15; s3[4] := 6;
  s3[5] := 9; s3[6] := 2; s3[7] := 12; s3[8] := 10;
  s3[9] := 11; s3[10] := 7; s3[11] := 8; s3[12] := 1;
  s3[13] := 4; s3[14] := 3; s3[15] := 14; s3[16] := 0;
  s4[1] := 7; s4[2] := 15; s4[3] := 5; s4[4] := 10;
  s4[5] := 8; s4[6] := 1; s4[7] := 6; s4[8] := 13;
  s4[9] := 0; s4[10] := 9; s4[11] := 3; s4[12] := 14;
  s4[13] := 11; s4[14] := 4; s4[15] := 2; s4[16] := 12;
  s5[1] := 12; s5[2] := 8; s5[3] := 2; s5[4] := 1;
  s5[5] := 13; s5[6] := 4; s5[7] := 15; s5[8] := 6;
  s5[9] := 7; s5[10] := 0; s5[11] := 10; s5[12] := 5;
  s5[13] := 3; s5[14] := 14; s5[15] := 9; s5[16] := 11;
  s6[1] := 11; s6[2] := 3; s6[3] := 5; s6[4] := 8;
  s6[5] := 2; s6[6] := 15; s6[7] := 10; s6[8] := 13;
  s6[9] := 14; s6[10] := 1; s6[11] := 7; s6[12] := 4;
  s6[13] := 12; s6[14] := 9; s6[15] := 6; s6[16] := 0;
  s7[1] := 6; s7[2] := 8; s7[3] := 2; s7[4] := 3;
  s7[5] := 9; s7[6] := 10; s7[7] := 5; s7[8] := 12;
  s7[9] := 1; s7[10] := 14; s7[11] := 4; s7[12] := 7;
  s7[13] := 11; s7[14] := 13; s7[15] := 0; s7[16] := 15;
  s8[1] := 12; s8[2] := 4; s8[3] := 6; s8[4] := 2;
  s8[5] := 10; s8[6] := 5; s8[7] := 11; s8[8] := 9;
  s8[9] := 14; s8[10] := 8; s8[11] := 13; s8[12] := 7;
  s8[13] := 0; s8[14] := 3; s8[15] := 15; s8[16] := 1;
  key[1] := 4293844428;
  key[2] := 3148519816;
  key[3] := 2003195204;
  key[4] := 857870592;
  key[5] := 4042388211;
  key[6] := 4109760247;
  key[7] := 4177132283;
  key[8] := 4244504319;
  gostinit(ctx, key, s8, s7, s6, s5, s4, s3, s2, s1);

  (* чистка остатка прежнего прогона *)
  arfadel(14422452B, 14231017B, 3607417B, 1464237B, ok);
  writeln('УНИЧТОЖЕНИЕ ОСТАТКА: КОД=', ok);

  (* создание области ТЕКСТ длиной 2 зоны *)
  arfacre(14422452B, 14231017B, 3607417B, 1464237B, 2, ok);
  writeln('СОЗДАНИЕ ОБЛАСТИ ТЕКСТ (2 ЗОНЫ): КОД=', ok);

  (* отрывок 1 - 8 слов в зону 0 *)
  fragA[1].a := 'ОТРЫВО';
  fragA[2].a := 'К ПЕРВ';
  fragA[3].a := 'ЫЙ: ЗА';
  fragA[4].a := 'ПИСЬ В';
  fragA[5].a := ' ЗОНУ ';
  fragA[6].a := ' 0000 ';
  fragA[7].a := 'ОБЛАСТ';
  fragA[8].a := 'И АРФА';
  for i := 1 to 8 do begin
    ibuf[2*i-1] := fragA[i].l;
    ibuf[2*i] := fragA[i].r
  end;
  arfawre(14422452B, 14231017B, 3607417B, 1464237B,
    8, 0, 777, ctx, ref(ibuf[1]), ok);
  writeln('ЗАПИСЬ ЗАШИФРОВАННОГО ОТРЫВКА 1 В ЗОНУ 0: КОД=', ok);

  (* отрывок 2 - 6 слов в зону 1 *)
  fragB[1].a := 'ОТРЫВО';
  fragB[2].a := 'К ВТОР';
  fragB[3].a := 'ОЙ: ЧТ';
  fragB[4].a := 'ЕНИЕ И';
  fragB[5].a := 'З ЗОНЫ';
  fragB[6].a := ' 0001 ';
  for i := 1 to 6 do begin
    ibuf[2*i-1] := fragB[i].l;
    ibuf[2*i] := fragB[i].r
  end;
  arfawre(14422452B, 14231017B, 3607417B, 1464237B,
    6, 1, 888, ctx, ref(ibuf[1]), ok);
  writeln('ЗАПИСЬ ЗАШИФРОВАННОГО ОТРЫВКА 2 В ЗОНУ 1: КОД=', ok);

  (* чтение и расшифрование отрывка 1 *)
  arfardd(14422452B, 14231017B, 3607417B, 1464237B,
    8, 0, ctx, ref(obuf[1]), ok);
  writeln('ЧТЕНИЕ И РАСШИФРОВАНИЕ ОТРЫВКА 1: КОД=', ok);
  for i := 1 to 8 do begin
    res[i].l := obuf[2*i-1];
    res[i].r := obuf[2*i]
  end;
  write('ОТРЫВОК 1: ');
  for i := 1 to 8 do
    write(res[i].a);
  writeln;
  ok := 0;
  for i := 1 to 8 do
    if res[i].a <> fragA[i].a then ok := 1;
  if ok = 0 then
    writeln('СВЕРКА ОТРЫВКА 1: ТЕКСТ ВОССТАНОВЛЕН ВЕРНО')
  else
    writeln('СВЕРКА ОТРЫВКА 1: РАСХОЖДЕНИЕ ТЕКСТА');

  (* чтение и расшифрование отрывка 2 *)
  arfardd(14422452B, 14231017B, 3607417B, 1464237B,
    6, 1, ctx, ref(obuf[1]), ok);
  writeln('ЧТЕНИЕ И РАСШИФРОВАНИЕ ОТРЫВКА 2: КОД=', ok);
  for i := 1 to 6 do begin
    res[i].l := obuf[2*i-1];
    res[i].r := obuf[2*i]
  end;
  write('ОТРЫВОК 2: ');
  for i := 1 to 6 do
    write(res[i].a);
  writeln;
  ok := 0;
  for i := 1 to 6 do
    if res[i].a <> fragB[i].a then ok := 1;
  if ok = 0 then
    writeln('СВЕРКА ОТРЫВКА 2: ТЕКСТ ВОССТАНОВЛЕН ВЕРНО')
  else
    writeln('СВЕРКА ОТРЫВКА 2: РАСХОЖДЕНИЕ ТЕКСТА');

  (* уничтожение области *)
  arfadel(14422452B, 14231017B, 3607417B, 1464237B, ok);
  writeln('УНИЧТОЖЕНИЕ ОБЛАСТИ ТЕКСТ: КОД=', ok);
  writeln('КОНЕЦ ТЕСТА ARFALIB')
end.
*execute
*end file
``````
